<!ELEMENT cafe (brand, tagline, introduction, menu, media, footer)>
<!ELEMENT brand (#PCDATA)>
<!ELEMENT tagline (#PCDATA)>
<!ELEMENT introduction (#PCDATA)>
<!ELEMENT menu (item+)>
<!ELEMENT item (name, price, description)>
<!ATTLIST item id ID #REQUIRED dietary (vegetarian | contains-chicken) #REQUIRED>
<!ELEMENT name (#PCDATA)>
<!ELEMENT price (#PCDATA)>
<!ATTLIST price currency (AUD) #REQUIRED>
<!ELEMENT description (#PCDATA)>
<!ELEMENT media (image, audio)>
<!ELEMENT image EMPTY>
<!ATTLIST image src CDATA #REQUIRED alt CDATA #REQUIRED width CDATA #REQUIRED height CDATA #REQUIRED>
<!ELEMENT audio EMPTY>
<!ATTLIST audio src CDATA #REQUIRED type CDATA #REQUIRED title CDATA #REQUIRED>
<!ELEMENT footer (copyright)>
<!ELEMENT copyright (#PCDATA)>